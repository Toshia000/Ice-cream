<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="styles/style.css">
    <link rel="icon" href="images/ice_cream_favicon.png">
    <script src="js/ice-cream.js" defer></script>
    <title>Ice Cream Order Form</title>
</head>
<body>
    <div id="main">
        <h1>Ice Cream Order Form</h1>
        <form id="ice-cream-form" action="/submit-order" method="post" novalidate>

            <fieldset id="personal-info">
                <legend>Personal Information</legend>

                <label for="name">Name:</label>
                <input type="text" id="name" name="name">
                <span class="err" id="err-name">Name is required</span>

                <label for="email">Email:</label>
                <input type="email" id="email" name="email">
                <span class="err" id="err-email-empty">Email is required</span>
                <span class="err" id="err-email-format">Email address should contain '@' symbol</span>
            </fieldset>

            <fieldset>
                <legend>Order Details</legend>

                <label for="flavor">Choose your flavor:</label>
                <select name="flavor" id="flavor">
                    <option value="none">-- not selected --</option>
                    <option value="vanilla">Vanilla</option>
                    <option value="chocolate">Chocolate</option>
                    <option value="strawberry">Strawberry</option>
                    <option value="caramel">Caramel</option>
                    <option value="mint-with-chocolate-chip">Mint with chocolate chip</option>
                </select>
                <span class="err" id="err-flavor">Please select a flavor</span>

                <p>Choose your cone:</p>
                <label for="waffle-cone">
                    <input type="radio" id="waffle-cone" name="cone" value="waffle-cone">
                    Waffle Cone
                </label>

                <label for="sugar-cone">
                    <input type="radio" id="sugar-cone" name="cone" value="sugar-cone">
                    Sugar Cone
                </label>

                <label for="cup">
                    <input type="radio" id="cup" name="cone" value="cup">
                    Cup
                </label>
                <span class="err" id="err-cone">Please select a cone type</span>

                <p>Toppings:</p>
                <label for="sprinkles">
                    <input type="checkbox" id="sprinkles" name="toppings[]" value="sprinkles">
                    Sprinkles
                </label>

                <label for="nuts">
                    <input type="checkbox" id="nuts" name="toppings[]" value="nuts">
                    Nuts
                </label>

                <label for="cherry">
                    <input type="checkbox" id="cherry" name="toppings[]" value="cherry">
                    Cherry
                </label>

                <label for="whipped-cream">
                    <input type="checkbox" id="whipped-cream" name="toppings[]" value="whipped-cream">
                    Whipped Cream
                </label>

                <p></p>
                <label for="comments">Additional comments:</label>
                <textarea name="comments" id="comments" rows="5" cols="40"></textarea>
            </fieldset>

            <div id="button-wrap">
                <button type="submit" id="order-button">Submit Order</button>
                <a href="/admin" id="admin-button">View All Orders</a>
            </div>
        </form>
    </div>
</body>
</html>