<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confrim</title>
</head>
<body>
    <h1>Thank you for your order!</h1>
    <p>Your ice cream order has been confirmed!</p>

    <h2>Personal information</h2>
    <p>Name: <%= order.name %></p>
    <p>Email: <%= order.email %></p>

    <h2>Order details</h2>
    <p>Flavor: <%= order.flavor %></p>
    <p>Cone Type: <%= order.cone %></p>
    <p>Topping: <%= order.toppings %></p>

    <h2>Additional comments</h2>
    <p>Comment: <%= order.comments %></p>
</body>
</html>